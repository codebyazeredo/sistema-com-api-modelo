{
    "name": "branet/sistema-com-api-modelo",
    "description": "Esqueleto Laminas (web + API JWT) para novos sistemas e backends de app",
    "type": "project",
    "license": "proprietary",
    "keywords": [
        "laminas",
        "mvc",
        "skeleton",
        "framework"
    ],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "doctrine/doctrine-orm-module": "^6.3",
        "firebase/php-jwt": "^7.1",
        "laminas/laminas-authentication": "^2.19",
        "laminas/laminas-component-installer": "^3.4.0",
        "laminas/laminas-development-mode": "^3.12.0",
        "laminas/laminas-mvc": "^3.7.0",
        "laminas/laminas-session": "^2.27",
        "laminas/laminas-skeleton-installer": "^1.3.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "laminas/laminas-test": "^4.9",
        "phpunit/phpunit": "^10.4",
        "psalm/plugin-phpunit": "^0.19.0",
        "squizlabs/php_codesniffer": "^3.7",
        "vimeo/psalm": "^5.13"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/",
            "Auth\\": "module/Auth/src/",
            "Api\\": "module/Api/src/",
            "Modelo\\": "module/Modelo/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {}
    },
    "scripts": {
        "clear-config-cache": "php bin/clear-config-cache.php",
        "cs-check": "vendor/bin/phpcs",
        "cs-fix": "vendor/bin/phpcbf",
        "development-disable": "laminas-development-mode disable",
        "development-enable": "laminas-development-mode enable",
        "development-status": "laminas-development-mode status",
        "post-create-project-cmd": [
            "@development-enable",
            "php bin/update-gitignore.php",
            "php -r 'if (file_exists(\"bin/remove-package-artifacts.php\")) include \"bin/remove-package-artifacts.php\";'"
        ],
        "post-install-cmd": "@clear-config-cache",
        "post-update-cmd": "@clear-config-cache",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public"
        ],
        "test": "vendor/bin/phpunit",
        "test:local": [
            "@database:enum",
            "@database:update",
            "vendor/bin/phpunit"
        ],
        "static-analysis": "vendor/bin/psalm --stats",

        "database:create": "php bin/create-database.php",
        "database:init": [
            "@database:create",
            "vendor/bin/doctrine-module orm:schema-tool:drop --force",
            "vendor/bin/doctrine-module orm:schema-tool:create"
        ],
        "database:update": [
            "vendor/bin/doctrine-module orm:clear-cache:metadata",
            "vendor/bin/doctrine-module orm:clear-cache:result",
            "vendor/bin/doctrine-module orm:clear-cache:query",
            "vendor/bin/doctrine-module orm:schema-tool:update --force --complete"
        ],
        "database:check": "vendor/bin/doctrine-module orm:validate-schema",
        "database:sql": "vendor/bin/doctrine-module orm:schema-tool:update --dump-sql --complete",
        "database:clear": [
            "vendor/bin/doctrine-module orm:clear-cache:metadata",
            "vendor/bin/doctrine-module orm:clear-cache:result",
            "vendor/bin/doctrine-module orm:clear-cache:query"
        ],
        "database:enum": "php bin/database-enum.php"
    },
    "scripts-descriptions": {
        "clear-config-cache": "Clears merged config cache. Required for config changes to be applied.",
        "cs-check": "Run coding standards checks.",
        "cs-fix": "Automatically fix coding standard issues.",
        "development-disable": "Disable development mode.",
        "development-enable": "Enable development mode.",
        "development-status": "Detail whether or not the application is in development mode.",
        "serve": "Start the built-in PHP web server and serve the application.",
        "static-analysis": "Run static analysis tool Psalm.",
        "test": "Run unit tests.",
        "test:local": "Sync enum tables, update schema and run unit tests.",
        "database:create": "Create the configured MySQL database if it doesn't exist yet.",
        "database:init": "DESTRUCTIVE: create db, drop and recreate the whole schema from scratch.",
        "database:update": "Clear Doctrine caches and apply pending schema changes (safe, additive).",
        "database:check": "Validate that entity mappings match the current database schema.",
        "database:sql": "Preview the SQL that database:update would run, without applying it.",
        "database:clear": "Clear Doctrine's metadata/result/query caches.",
        "database:enum": "Placeholder to sync enum/lookup tables for your domain (edit bin/database-enum.php)."
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "laminas/laminas-skeleton-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
