<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var \Auth\Form\LoginForm $form
 * @var string|null $erro
 */
$form->setAttribute('method', 'post');
$form->prepare();

$login = $form->get('login');
$senha = $form->get('senha');
$csrf = $form->get('login_csrf');
?>
<div class="w-full max-w-sm">
    <div class="mb-6 text-center">
        <h1 class="text-xl font-semibold text-white">Entrar</h1>
        <p class="mt-1 text-sm text-gray-400">Acesse sua conta para continuar</p>
    </div>

    <div class="rounded-lg bg-white p-6 shadow-lg">
        <?php if ($erro): ?>
        <div class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">
            <?= $this->escapeHtml($erro) ?>
        </div>
        <?php endif; ?>

        <form method="post" action="<?= $this->url('login') ?>" class="space-y-4">
            <div>
                <label for="login" class="block text-sm font-medium text-gray-700">
                    <?= $this->escapeHtml($login->getLabel()) ?>
                </label>
                <input
                    type="text"
                    name="login"
                    id="login"
                    autocomplete="username"
                    value="<?= $this->escapeHtmlAttr((string) $login->getValue()) ?>"
                    class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                >
            </div>

            <div>
                <label for="senha" class="block text-sm font-medium text-gray-700">
                    <?= $this->escapeHtml($senha->getLabel()) ?>
                </label>
                <input
                    type="password"
                    name="senha"
                    id="senha"
                    autocomplete="current-password"
                    class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500"
                >
            </div>

            <input type="hidden" name="login_csrf" value="<?= $this->escapeHtmlAttr((string) $csrf->getValue()) ?>">

            <button
                type="submit"
                class="w-full rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800"
            >
                Entrar
            </button>
        </form>
    </div>
</div>
