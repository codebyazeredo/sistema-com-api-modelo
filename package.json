{
  "name": "sistema-com-api-modelo",
  "private": true,
  "version": "1.0.0",
  "description": "Frontend (Tailwind + Alpine.js) do esqueleto sistema-com-api-modelo",
  "scripts": {
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./resources/css/app.css -o ./public/css/app.css --watch",
    "build:js": "node scripts/build-js.mjs",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": {
    "alpinejs": "^3.14.9"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17"
  }
}
